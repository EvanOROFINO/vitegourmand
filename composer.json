{
    "name": "evanorofino/vitegourmand",
    "description": "Application web traiteur Vite & Gourmand - ECF 2 TP DWWM Studi",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "mongodb/mongodb": "^1.19",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
